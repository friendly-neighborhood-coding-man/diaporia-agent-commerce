# Non-secret stack settings. Copy to deploy/remote-mcp/.env (not committed) and edit.
# PROPOSED hostname: owner approval and a DNS record are separate gates (docs/REMOTE_MCP_SECURITY_GATES.md).
MCP_HOSTNAME=mcp.diaporia.com
# Edge mode (edge/<mode>.{global,site}.caddy):
#   direct      DNS-only record (gate A2 option A, recommended): Let's Encrypt, contact CADDY_EMAIL;
#               no proxy trusted, the client address is the TCP peer.
#   cloudflare  proxied record (gate A2 option B): needs ORIGIN_CERT_DIR with origin.pem, origin.key and
#               origin-pull-ca.pem, and edge/cloudflare-ips.caddy from scripts/remote/cloudflare-ips.mjs.
#   local       local HTTPS emulation only (Caddy internal CA). Never on a public host.
CADDY_EDGE=direct
CADDY_EMAIL=replace-with-acme-email
ORIGIN_CERT_DIR=./certs
# IPv4 only (see compose.yaml). Publish an A record only, no AAAA.
PUBLISH_HTTP=0.0.0.0:80
PUBLISH_HTTPS=0.0.0.0:443
DIAPORIA_IMAGE_TAG=replace-with-git-sha
DIAPORIA_SECRETS_FILE=./secrets/app.env
# Limits per client per minute (the app sees real client addresses through Caddy).
DIAPORIA_WEB_RATE_PER_MIN=30
DIAPORIA_MCP_RATE_PER_MIN=120
DIAPORIA_MAX_OAUTH_CLIENTS=200
DIAPORIA_REGISTER_PER_HOUR=10
# Absolute grant lifetime (seconds). Keep it to the approved research window.
DIAPORIA_GRANT_MAX_AGE_SEC=86400
# Rotating or removing an owner key revokes that key's grants automatically at the next start.
# Set to 1 for exactly one start to revoke every grant (incident response), then back to 0.
DIAPORIA_REVOKE_ALL_GRANTS_ON_START=0

# --- secrets/app.env (mode 0600, NEVER committed) holds only: ---
# DIAPORIA_OWNER_KEYS=drk_<43 random chars from `npm run remote:owner-key`>=eric-remote
# DIAPORIA_OAUTH_CLIENTS=<env_entry from `npm run remote:oauth-client -- --user eric-remote --name "Claude (Eric)" --redirect https://claude.ai/api/mcp/auth_callback`>
#   (holds only the client secret's sha256; the clear secret goes to the owner once, out of band)
# Never put PAYPAL_*, KERNEL_*, HANDOFF_*, TAVILY/CHANNEL3 keys or DIAPORIA_DEV_TOKENS there: the service refuses to start.
