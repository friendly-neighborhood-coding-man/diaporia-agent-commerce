# Non-secret stack settings. Copy to deploy/remote-mcp/.env (not committed) and edit.
# PROPOSED hostname: owner approval and a DNS record are separate gates (docs/REMOTE_MCP_SECURITY_GATES.md).
MCP_HOSTNAME=mcp.diaporia.com
# Let's Encrypt (DNS-only record):   CADDY_TLS=you@example.com   and CADDY_EMAIL=you@example.com
# Cloudflare Origin CA (proxied):    CADDY_TLS=/certs/origin.pem /certs/origin.key   with ORIGIN_CERT_DIR=/etc/diaporia/origin
CADDY_TLS=replace-with-acme-email-or-cert-paths
CADDY_EMAIL=replace-with-acme-email
ORIGIN_CERT_DIR=./certs
PUBLISH_HTTP=80
PUBLISH_HTTPS=443
DIAPORIA_IMAGE_TAG=replace-with-git-sha
DIAPORIA_SECRETS_FILE=./secrets/app.env
# Limits per client per minute (the app sees real client addresses through Caddy).
DIAPORIA_WEB_RATE_PER_MIN=30
DIAPORIA_MCP_RATE_PER_MIN=120
DIAPORIA_MAX_OAUTH_CLIENTS=200
DIAPORIA_REGISTER_PER_HOUR=10
# Absolute grant lifetime (seconds). Keep it to the approved research window.
DIAPORIA_GRANT_MAX_AGE_SEC=86400
# Set to 1 for exactly one start after rotating owner keys, then back to 0.
DIAPORIA_REVOKE_ALL_GRANTS_ON_START=0

# --- secrets/app.env (mode 0600, NEVER committed) holds only: ---
# DIAPORIA_OWNER_KEYS=drk_<43 random chars from `npm run remote:owner-key`>=eric-remote
# Never put PAYPAL_*, KERNEL_*, HANDOFF_*, TAVILY/CHANNEL3 keys or DIAPORIA_DEV_TOKENS there: the service refuses to start.
