{
  "name": "diaporia-agent-commerce",
  "version": "0.8.0",
  "description": "A cross-platform AI purchasing engine with evidence-based product research, bounded checkout authorization, and PayPal Sandbox integration. Built for MCP-enabled assistants.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json && tsc -p apps/phase-c-test-merchant/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "mandate:create": "tsx scripts/create-mandate.ts",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "preflight:sandbox": "tsx scripts/sandbox-preflight.ts",
    "demo:identity": "tsx scripts/demo-merchant-identity.ts",
    "demo:quote": "tsx scripts/demo-merchant-quote.ts",
    "demo:subscription": "tsx scripts/demo-subscription.ts",
    "sandbox:subscription": "tsx scripts/subscription-sandbox.ts",
    "smoke:shopify": "tsx scripts/shopify-smoke.ts",
    "demo:service": "tsx scripts/demo-service.ts",
    "live:smoke": "tsx scripts/live-smoke.ts",
    "live:evidence": "tsx scripts/live-evidence-check.ts",
    "demo:handoff": "tsx scripts/demo-handoff.ts",
    "merchant:start": "tsx apps/phase-c-test-merchant/src/main.ts",
    "merchant:start:built": "node dist-merchant/apps/phase-c-test-merchant/src/main.js",
    "phase-c:approval": "tsx scripts/phase-c-approval.ts",
    "phase-c:recipe": "tsx scripts/phase-c-recipe.ts",
    "demo:phase-c": "tsx scripts/demo-phase-c.ts",
    "phase-c:c3-compare": "tsx scripts/phase-c-c3-compare.ts",
    "phase-c:kernel-check": "tsx scripts/phase-c-kernel-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Eric Lee Kim"
}
