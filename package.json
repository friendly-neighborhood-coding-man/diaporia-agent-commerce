{
  "name": "diaporia-agent-commerce",
  "version": "0.8.0",
  "description": "A cross-platform AI purchasing engine with evidence-based product research, bounded checkout authorization, and PayPal Sandbox integration. Built for MCP-enabled assistants.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "mandate:create": "tsx scripts/create-mandate.ts",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "preflight:sandbox": "tsx scripts/sandbox-preflight.ts",
    "demo:identity": "tsx scripts/demo-merchant-identity.ts",
    "demo:quote": "tsx scripts/demo-merchant-quote.ts",
    "smoke:shopify": "tsx scripts/shopify-smoke.ts",
    "demo:service": "tsx scripts/demo-service.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
