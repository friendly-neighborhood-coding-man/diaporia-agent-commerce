# DIAPORIA Agent Commerce — placeholders only. Copy to .env (gitignored) if needed.
# The default demo needs NONE of these: fixture catalog + mock PayPal.

HOST=127.0.0.1
PORT=8790
# Externally visible origin. Any non-loopback value DISABLES payment execution.
PUBLIC_BASE_URL=
# dev | public-readonly-demo  (public-readonly-demo: no auth, research/compare/status only)
DIAPORIA_AUTH_MODE=dev
DIAPORIA_DB_PATH=.data/diaporia.sqlite

# Development-only per-user tokens (NOT OAuth). Leave empty to auto-generate into .data/.
# Format: token=userId:scope1,scope2;token2=userId2:...
DIAPORIA_DEV_TOKENS=
# Human-held owner keys that can create spending mandates. Format: key=userId;...
DIAPORIA_OWNER_KEYS=

# mock | paypal_sandbox
PAYMENT_PROVIDER=mock
# Only needed for PAYMENT_PROVIDER=paypal_sandbox. Sandbox app credentials only; Live is refused.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=SANDBOX
# Merchant id of YOUR Sandbox business account (the real recipient of Sandbox demo payments).
# Required for PAYMENT_PROVIDER=paypal_sandbox: without it the order recipient cannot be verified and checkouts HOLD.
PAYPAL_SANDBOX_PAYEE_MERCHANT_ID=
# Optional: the same Sandbox business account's email; if set, the order payee email must match too.
PAYPAL_SANDBOX_PAYEE_EMAIL=
# Optional: id of a registered PayPal webhook. Enables POST /paypal/webhook (needs a public HTTPS listener, not set up here).
PAYPAL_WEBHOOK_ID=

# Managed billing (managed mode only; see docs/MANAGED_BILLING.md)
# subscriptions-mock (default: fake PayPal in-process) | paypal-sandbox-subscriptions | legacy-mock
MANAGED_BILLING=subscriptions-mock
# Sandbox adapter only: "placeholder" uses labelled placeholder plan prices; unset = prices UNKNOWN, nothing can be subscribed
MANAGED_PLAN_PRICES=
# Webhook id of the registered BILLING listener (/billing/paypal/webhook). Separate from PAYPAL_WEBHOOK_ID (merchandise).
PAYPAL_BILLING_WEBHOOK_ID=

# Merchant Quote V0 (optional): a Shopify Development Store for `npm run smoke:shopify` / `npm run demo:quote`.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_VARIANT_ID=
SHOPIFY_STOREFRONT_TOKEN=

# Deployment: community (self-hosted, BYOK, no DIAPORIA billing) | managed (needs production auth; only DIAPORIA_MANAGED_SIMULATION=1 on loopback today)
DIAPORIA_DEPLOYMENT_MODE=community
DIAPORIA_MANAGED_SIMULATION=
# Evidence providers: mock (default, free) | byok (uses TAVILY_API_KEY below; KERNEL BYOK not yet in the public repo)
EVIDENCE_PROVIDERS=mock
# Catalog: mock (default fixtures) | channel3 (needs CHANNEL3_API_KEY; listings only, no merchant quotes)
RESEARCH_PROVIDER=mock
CHANNEL3_API_KEY=
TAVILY_API_KEY=
