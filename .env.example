# DIAPORIA Agent Commerce — placeholders only. Copy to .env (gitignored) if needed.
# The default demo needs NONE of these: fixture catalog + mock PayPal.

HOST=127.0.0.1
PORT=8790
# Externally visible origin. Any non-loopback value DISABLES payment execution.
PUBLIC_BASE_URL=
# dev | public-readonly-demo  (public-readonly-demo: no auth, research/compare/status only)
DIAPORIA_AUTH_MODE=dev
DIAPORIA_DB_PATH=.data/diaporia.sqlite

# Development-only per-user tokens (NOT OAuth). Leave empty to auto-generate into .data/.
# Format: token=userId:scope1,scope2;token2=userId2:...
DIAPORIA_DEV_TOKENS=
# Human-held owner keys that can create spending mandates. Format: key=userId;...
DIAPORIA_OWNER_KEYS=

# mock | paypal_sandbox
PAYMENT_PROVIDER=mock
# Only needed for PAYMENT_PROVIDER=paypal_sandbox. Sandbox app credentials only; Live is refused.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=SANDBOX
# Merchant id of YOUR Sandbox business account (the real recipient of Sandbox demo payments).
# Required for PAYMENT_PROVIDER=paypal_sandbox: without it the order recipient cannot be verified and checkouts HOLD.
PAYPAL_SANDBOX_PAYEE_MERCHANT_ID=
# Optional: the same Sandbox business account's email; if set, the order payee email must match too.
PAYPAL_SANDBOX_PAYEE_EMAIL=
# Optional: id of a registered PayPal webhook. Enables POST /paypal/webhook (needs a public HTTPS listener, not set up here).
PAYPAL_WEBHOOK_ID=

# Managed billing (managed mode only; see docs/MANAGED_BILLING.md)
# subscriptions-mock (default: fake PayPal in-process) | paypal-sandbox-subscriptions | legacy-mock
MANAGED_BILLING=subscriptions-mock
# Sandbox adapter only: "placeholder" uses labelled placeholder plan prices; unset = prices UNKNOWN, nothing can be subscribed
MANAGED_PLAN_PRICES=
# Webhook id of the registered BILLING listener (/billing/paypal/webhook). Separate from PAYPAL_WEBHOOK_ID (merchandise).
PAYPAL_BILLING_WEBHOOK_ID=

# Merchant Quote V0 (optional): a Shopify Development Store for `npm run smoke:shopify` / `npm run demo:quote`.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_VARIANT_ID=
SHOPIFY_STOREFRONT_TOKEN=

# Deployment: community (self-hosted, BYOK, no DIAPORIA billing) | managed (needs production auth; only DIAPORIA_MANAGED_SIMULATION=1 on loopback today)
DIAPORIA_DEPLOYMENT_MODE=community
DIAPORIA_MANAGED_SIMULATION=
# Evidence providers: mock (default, free) | byok (uses TAVILY_API_KEY, and KERNEL_API_KEY if set, below)
EVIDENCE_PROVIDERS=mock
# Catalog: mock (default fixtures) | channel3 (needs CHANNEL3_API_KEY; listings only, no merchant quotes)
RESEARCH_PROVIDER=mock
CHANNEL3_API_KEY=
TAVILY_API_KEY=
# Optional, PAID per browser-second: KERNEL original-page inspection (byok mode only; off when empty).
KERNEL_API_KEY=
# Safety gate: off by default, even if a key is available. Paid original-page inspection is owner opt-in.
# This does NOT certify remote browser DNS/IP egress isolation. Use only after controlled validation.
DIAPORIA_ENABLE_LIVE_KERNEL_INSPECTION=
# Hard cap on KERNEL browser sessions per server process (default 20). Per-request cap is 1.
KERNEL_MAX_SESSIONS=

# Browser checkout handoff (separate path from the PayPal Sandbox checkout). off (default) | fixture | kernel
#   fixture: offline synthetic merchant on 127.0.0.1 + local Chromium (HANDOFF_FIXTURE_HEADED=1 to show it)
#   kernel:  KERNEL headful browsers — BILLED; needs DIAPORIA_ALLOW_KERNEL_LIVE=1, KERNEL_API_KEY, HANDOFF_RECIPES_FILE
HANDOFF_DRIVER=off
HANDOFF_FIXTURE_HEADED=
DIAPORIA_ALLOW_KERNEL_LIVE=
# Reuse the KERNEL_API_KEY above. This flag separately authorizes a billed human handoff browser.
HANDOFF_RECIPES_FILE=
HANDOFF_KERNEL_MAX_SESSIONS=2

# Phase C: authenticated seller status of the Phase C test merchant (KERNEL mode only; both or neither).
# The origin must equal the reviewed Phase C recipe origin; the secret equals the merchant's MERCHANT_STATUS_SECRET.
# Unset = no seller source, so the best outcome stays ORDER_UNVERIFIED.
PHASE_C_SELLER_ORIGIN=
PHASE_C_SELLER_STATUS_SECRET=

# ---- Phase C TEST MERCHANT (apps/phase-c-test-merchant; runs on the merchant host, not with DIAPORIA) ----
# MOCK (default, offline) | SANDBOX_POPUP_TEST (C1, no capture) | SANDBOX_APPROVAL_TEST (C2). Sandbox modes need an owner-approved digest.
MERCHANT_CHECKOUT_MODE=MOCK
MERCHANT_LISTEN_HOST=127.0.0.1
MERCHANT_LISTEN_PORT=8791
MERCHANT_PUBLIC_ORIGIN=
MERCHANT_PAYPAL_CLIENT_ID=
MERCHANT_PAYPAL_CLIENT_SECRET=
MERCHANT_PAYPAL_SELLER_MERCHANT_ID=
MERCHANT_DATA_DIR=
MERCHANT_STATUS_SECRET=
MERCHANT_OPERATOR_KEY=
PHASE_C_APPROVAL_EXPIRES_AT=
PHASE_C_MAX_MINUTES=
# Estimate only; NOT enforced (no monetary circuit breaker). Set an account-side KERNEL limit.
PHASE_C_KERNEL_USD_ESTIMATE=
PHASE_C_SOURCE_COMMIT=
PHASE_C_DIAPORIA_ARTIFACT_SHA256=
PHASE_C_DIAPORIA_HOST=
PHASE_C_DIAPORIA_SERVICE_USER=
# Owner's Ed25519 PUBLIC key (PEM). The private key stays on the owner's machine.
PHASE_C_OWNER_PUBLIC_KEY_FILE=
PHASE_C_APPROVED_DIGEST=
PHASE_C_APPROVAL_SIGNATURE=
# DIAPORIA side (KERNEL mode with the Phase C recipe): the statement JSON printed by npm run phase-c:approval
PHASE_C_APPROVAL_STATEMENT_FILE=
